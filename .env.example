# Maps JavaScript API key — never commit a real value.
# GitHub Pages: repo Settings → Secrets and variables → Actions → VITE_GOOGLE_MAPS_API_KEY
# Local: copy to .env.local
VITE_GOOGLE_MAPS_API_KEY=

# Ticketmaster Discovery API key — optional. Used in the browser for theater
# listings on Add / Refresh. Club calendars (seed + known Laylo drops such as
# Andrew Schulz) load without this key. Get one at
# https://developer.ticketmaster.com/ (Discovery API).
# GitHub Pages: repo secret VITE_TICKETMASTER_API_KEY (baked into the Vite build).
VITE_TICKETMASTER_API_KEY=

# Optional SeatGeek client id — fills in dates Ticketmaster misses.
# https://seatgeek.com/account/develop
# GitHub Pages: repo secret VITE_SEATGEEK_CLIENT_ID
VITE_SEATGEEK_CLIENT_ID=
